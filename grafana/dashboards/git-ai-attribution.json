{
  "uid": "git-ai-attribution",
  "title": "Git AI \u2014 Code Attribution",
  "description": "Line-level AI attribution from git-ai, over a rolling 30-day window of locally committed code. At low coverage this is an adoption and data-quality view: read every percentage next to the sample size beside it.",
  "tags": [
    "ai",
    "git-ai",
    "attribution",
    "observability"
  ],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "query": "label_values(gitai_commits_total, repo)",
          "refId": "repo"
        },
        "definition": "label_values(gitai_commits_total, repo)",
        "sort": 1
      },
      {
        "name": "forge",
        "label": "Forge",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "query": "label_values(gitai_commits_total, forge)",
          "refId": "forge"
        },
        "definition": "label_values(gitai_commits_total, forge)",
        "sort": 1
      },
      {
        "name": "window",
        "label": "Sample freshness",
        "type": "custom",
        "query": "2h,6h,12h,24h,48h",
        "current": {
          "text": "6h",
          "value": "6h"
        },
        "options": [
          {
            "text": "2h",
            "value": "2h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": true
          },
          {
            "text": "12h",
            "value": "12h",
            "selected": false
          },
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          },
          {
            "text": "48h",
            "value": "48h",
            "selected": false
          }
        ],
        "description": "How far back to look for the most recent export. This is NOT the measurement period - the exporter always reports a rolling 30-day window. It only controls how stale a sample may be before panels go empty."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Coverage \u2014 can these numbers be trusted yet?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Line Attribution Coverage",
      "description": "Share of added lines in the rolling 30-day window that carry any attribution. git-ai cannot attribute code written before it was installed, so this starts near zero and climbs as new commits land. Everything else on this dashboard is only as trustworthy as this number.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8E66BC",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 * (sum(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])) + sum(last_over_time(gitai_human_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window]))) / clamp_min(sum(last_over_time(gitai_diff_added_lines{repo=~\"$repo\",forge=~\"$forge\"}[$window])), 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Commit Coverage",
      "description": "Commits in the rolling 30-day window carrying a git-ai note.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8E66BC",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 * sum(last_over_time(gitai_commits_with_authorship{repo=~\"$repo\",forge=~\"$forge\"}[$window])) / clamp_min(sum(last_over_time(gitai_commits_total{repo=~\"$repo\",forge=~\"$forge\"}[$window])), 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
