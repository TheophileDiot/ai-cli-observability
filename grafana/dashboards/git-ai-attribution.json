          "expr": "(sum(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])) + sum(last_over_time(gitai_human_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
