    {
      "id": 9,
      "type": "timeseries",
      "title": "Line Composition Over Time",
      "description": "Rolling-window totals. Unattributed dominates early and shrinks in share as attributed commits accumulate.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
