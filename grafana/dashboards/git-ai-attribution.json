                  "mode": "fixed",
                  "fixedColor": "#4A78D4"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Human"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C97B2E"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unattributed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8E66BC"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
