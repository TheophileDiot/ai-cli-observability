      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window]))",
          "legendFormat": "AI",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
