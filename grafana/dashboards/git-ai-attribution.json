    {
      "id": 12,
      "type": "bargauge",
      "title": "AI Share of Attributed Lines by Repo",
      "description": "Only repos with at least one attributed line appear. A repo absent here has no attributed commits yet, which is not the same as 0% AI - check Commit Coverage by Repo to tell those apart.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4A78D4"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 * sum by(repo)(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])) / clamp_min(sum by(repo)(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])) + sum by(repo)(last_over_time(gitai_human_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])), 1) and on(repo) ((sum by(repo)(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])) + sum by(repo)(last_over_time(gitai_human_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window]))) > 0)",
          "legendFormat": "{{repo}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Repository Detail",
      "description": "Per-repo breakdown. 'Stale' marks numbers replayed from cache because the last refresh failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
