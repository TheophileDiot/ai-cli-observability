{
  "uid": "git-ai-attribution",
  "title": "Git AI \u2014 Code Attribution",
  "description": "Line-level AI attribution from git-ai. Shows how much of the code that actually shipped was agent-written, alongside the coverage needed to judge whether those percentages mean anything yet.",
  "tags": ["ai", "git-ai", "attribution", "observability"],
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "query": "label_values(gitai_commits_total, repo)",
          "refId": "repo"
        },
        "definition": "label_values(gitai_commits_total, repo)",
        "sort": 1
      },
      {
        "name": "forge",
        "label": "Forge",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "query": "label_values(gitai_commits_total, forge)",
          "refId": "forge"
        },
        "definition": "label_values(gitai_commits_total, forge)",
        "sort": 1
      },
      {
        "name": "window",
        "label": "Freshness window",
        "type": "custom",
        "query": "2h,6h,12h,24h,48h",
        "current": {
          "text": "6h",
          "value": "6h"
        },
        "options": [
          {
            "text": "2h",
            "value": "2h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": true
          },
          {
            "text": "12h",
            "value": "12h",
            "selected": false
          },
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          },
          {
            "text": "48h",
            "value": "48h",
            "selected": false
          }
        ],
        "description": "How far back to look for the most recent export. The exporter pushes hourly, so a plain instant query would read 'No data' for most of each hour."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AI Share of Attributed Lines",
      "description": "Of the lines git-ai could attribute, the share an agent wrote. Deliberately not a share of *all* added lines: almost every line in these repos predates git-ai and is unattributable, which would drag any such number to near zero and say nothing. Read this next to Line Attribution Coverage.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4A78D4"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 * sum(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])) / clamp_min((sum(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])) + sum(last_over_time(gitai_human_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window]))), 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AI Lines Written",
      "description": "Agent-written lines added in the window.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4A78D4"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Acceptance Rate",
      "description": "Agent-written lines that survived into the commit. 100% means nothing was overwritten before committing.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#4A78D4"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 * sum(last_over_time(gitai_ai_accepted{repo=~\"$repo\",forge=~\"$forge\"}[$window])) / clamp_min(sum(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])), 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Line Attribution Coverage",
      "description": "Share of added lines carrying any attribution. Starts near zero and climbs only as new commits land: git-ai cannot attribute history written before it was installed. A low value here means the percentages above rest on a small sample.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8E66BC",
                "value": null
              },
              {
                "color": "text",
                "value": 25
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 * (sum(last_over_time(gitai_ai_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window])) + sum(last_over_time(gitai_human_additions{repo=~\"$repo\",forge=~\"$forge\"}[$window]))) / clamp_min(sum(last_over_time(gitai_diff_added_lines{repo=~\"$repo\",forge=~\"$forge\"}[$window])), 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Commit Coverage",
      "description": "Commits in the window carrying a git-ai note.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8E66BC",
                "value": null
              },
              {
                "color": "text",
                "value": 25
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 * sum(last_over_time(gitai_commits_with_authorship{repo=~\"$repo\",forge=~\"$forge\"}[$window])) / clamp_min(sum(last_over_time(gitai_commits_total{repo=~\"$repo\",forge=~\"$forge\"}[$window])), 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Repos Reporting",
      "description": "Repos that produced stats on the last run. A drop here is a pipeline problem, not a coding slowdown.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
